# ==============================================================================
# RETAILFLOW E-COMMERCE - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com credenciais seguras.
# NUNCA versione o arquivo .env real no controle de versão.
# ==============================================================================

# Configuração da Aplicação
ENVIRONMENT=development
DEBUG=True
APP_NAME="RetailFlow E-Commerce"
APP_HOST=0.0.0.0
APP_PORT=8000

# Chave Secreta para Assinatura de Tokens (JWT/CSRF)
# Gere uma chave segura aleatória (ex: openssl rand -hex 32)
SECRET_KEY=change-this-in-real-environments-with-a-secure-random-token-min-32-chars

# ------------------------------------------------------------------------------
# PostgreSQL - Instância Docker (Superusuário)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_this_root_password_in_production

# ------------------------------------------------------------------------------
# Banco de Dados de Desenvolvimento (retailflow_dev)
# ------------------------------------------------------------------------------
POSTGRES_DEV_DB=retailflow_dev
POSTGRES_DEV_USER=retailflow_dev_user
POSTGRES_DEV_PASSWORD=change_this_dev_password_in_production

# URL de Conexão Assíncrona para Desenvolvimento
# Quando rodando via Docker Compose use host 'db':
DATABASE_URL=postgresql+asyncpg://retailflow_dev_user:change_this_dev_password_in_production@db:5432/retailflow_dev
# Quando rodando localmente (fora do Docker):
# DATABASE_URL=postgresql+asyncpg://retailflow_dev_user:change_this_dev_password_in_production@localhost:5432/retailflow_dev

# ------------------------------------------------------------------------------
# Banco de Dados de Testes (retailflow_test)
# ------------------------------------------------------------------------------
POSTGRES_TEST_DB=retailflow_test
POSTGRES_TEST_USER=retailflow_test_user
POSTGRES_TEST_PASSWORD=change_this_test_password_in_production

# URL de Conexão Assíncrona para Testes
# Quando rodando testes via Docker use host 'db':
TEST_DATABASE_URL=postgresql+asyncpg://retailflow_test_user:change_this_test_password_in_production@db:5432/retailflow_test
# Quando rodando testes localmente (fora do Docker):
# TEST_DATABASE_URL=postgresql+asyncpg://retailflow_test_user:change_this_test_password_in_production@localhost:5432/retailflow_test

# ------------------------------------------------------------------------------
# Credenciais Iniciais de Administrador (Para scripts de seed/bootstrap)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@retailflow.local
INITIAL_ADMIN_PASSWORD=change_this_initial_admin_password
